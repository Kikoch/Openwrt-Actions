# ============================================================
# PonWrt 自定义附加包（在 configs/an7581.config 基础上追加）
# 基础配置已含: PON 全套(luci-app-pon/ponctl/pond/xpon)、NPU 固件、
#               EN8811H 固件、LuCI 基础、firewall、ppp 等
# ============================================================

# --- LuCI 中文 ---
CONFIG_LUCI_LANG_zh_Hans=y

# --- 主题: 只保留 bootstrap, 其余全部移除 (2026-10-08) ---
#
# 基线 configs/an7581.config:6397 是 CONFIG_PACKAGE_luci-theme-argon=y, 必须
# 在本文件里用 "is not set" 反向覆盖 (同名符号取最后一条; 只删上游那行无效)。
#
# 本 pin 的 immortalwrt/luci (ed0441b1) 里 themes/ 一共 6 个, 逐一核对过:
#   luci-theme-bootstrap        <- 唯一保留
#   luci-theme-argon            <- 关 (基线打开了)
#   luci-theme-footstrap        <- 关 (基线本来就是 not set, 这里写成显式)
#   luci-theme-material         <- 关 (同上)
#   luci-theme-openwrt          <- 关 (同上)
#   luci-theme-openwrt-2020     <- 关 (同上)
# 两个"不存在但容易误写"的: luci-theme-glass / luci-theme-aurora 在本 feed 是 404
#   (aurora 只存在于附件那份 r41408+7 私有树的源码树内), 写了也是被 defconfig
#   静默删符号, 留在此处仅作记录, 不写 =y。
#
# 三道保险: 这里 "is not set" -> ponwrt-diy-part2.sh 配置层硬断言 ->
#   workflow 的 FORBID_PKGS 产物层反向校验 (manifest 里出现即判失败)。
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-footstrap is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

# --- LuCI 应用 ---
# luci-app-openclash 由 immortalwrt/luci feed 提供。注意 luci 的 pin 提交很关键:
#   2026-09 那段时间 master 线拆走了这批第三方应用, 必须用 ed0441b1 之后的提交
#   (详见 ponwrt-feeds.conf)。写 =y 而 feed 里没这个包时, defconfig 静默删符号,
#   编译成功但固件里没有 —— run #16 就是这么丢的。
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ============================================================
# 2026-10-08 需求项: OpenClash / WireGuard / DDNS(dnspod) / zram
#   —— 组件本体 + 中文翻译 + 内核依赖, 逐条补齐并把"翻译包是否存在"写清楚。
#
#   中文界面总开关在下方的 CONFIG_LUCI_LANG_zh_Hans=y; luci.mk 的
#   LuciTranslation 里 `DEFAULT:=LUCI_LANG_zh_Hans||(ALL&&m)` —— 打开总开关后,
#   **已启用应用**的 luci-i18n-*-zh-cn 会自动默认 =y。仍然逐条显式写 =y,
#   是为了让 ponwrt-diy-part2.sh 能拿它做硬断言 (默认值无法断言)。
# ============================================================

# --- 1) OpenClash ---
# 本体 luci-app-openclash (见上方 LuCI 应用段) + 运行时依赖显式化。
# 它的 DEPENDS 是: +luci-compat +dnsmasq-full +bash +curl +ca-bundle +ip-full
#                 +ruby +ruby-yaml +kmod-inet-diag +kmod-nft-tproxy +kmod-tun +unzip
# 依赖本来会被 defconfig 自动拉进来, 这里全部显式写死, 避免上游改 DEPENDS 后
# 悄悄少东西 (缺 kmod-nft-tproxy 时 TUN 模式规则装不上, 表现为"代理没反应")。
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ca-bundle=y
# 中文翻译: **没有 luci-i18n-openclash-zh-cn 这个包**, 不要写 (写了会被 defconfig
#   静默删掉)。原因: 上游 applications/luci-app-openclash/Makefile 是
#   `include $(INCLUDE_DIR)/package.mk` + 裸 `BuildPackage`, 不走 luci.mk 的
#   i18n 生成机制; 它的中文在 Build/Prepare 里用 po2lmo 从 po/zh-cn/openclash.zh-cn.po
#   直接编进包体 (/usr/lib/lua/luci/i18n/openclash.zh-cn.lmo)。所以中文是天然带的。

# --- 2) WireGuard ---
# 本体 luci-proto-wireguard + wireguard-tools + kmod-wireguard 见上方;
# 补上 kmod-wireguard 的 UDP 隧道内核依赖 (UDP 隧道被拆成两个独立 kmod,
# 缺了 shepherd 起来的接口起不来)。
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y
# 中文翻译: **没有 luci-i18n-wireguard-zh-cn**。本 pin 的
#   protocols/luci-proto-wireguard/ 里压根没有 po/ 目录 (只有 Makefile /
#   htdocs / root), luci.mk 的 LuciTranslation 只对存在 po/<lang>/ 的包生成
#   i18n 包, 没有 po 就没有翻译包。该页面文字为英文, 属上游现状, 补不了。

# --- 3) DDNS (luci-app-ddns) + ddns-scripts-dnspod ---
# 本体四条见上方; 这里只补中文翻译 (本 pin 里 po/zh_Hans/ddns.po 存在 ->
#   会生成 luci-i18n-ddns-zh-cn, 名字经 LUCI_LC_ALIAS.zh_Hans=zh-cn 映射而来)。
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
# ddns-scripts-services 提供 services 定义 (含 dnspod 的取 IP 接口),
# ddns-scripts-dnspod 提供实际更新脚本, 两者缺一 dnspod 条目就报
# "Service not found"。curl/wget-ssl 在下方网络工具段已开。

# --- 4) zram ---
# 本体 + 全部压缩后端见下方 "内存扩展" 段 (zram-swap / kmod-zram /
#   kmod-lib-lzo / kmod-lib-lzo-rle / kmod-lib-lz4), 已齐。
# 中文翻译: zram 在本 feed 里**没有 LuCI 应用** (无 luci-app-zram), 没有界面
#   也就没有翻译包 —— 配置走 /etc/config/zram + /etc/init.d/zram-swap。

# ============================================================
# 强制移除 UPnP (run #16 产物里 luci-app-upnp / luci-i18n-upnp-zh-cn /
#   miniupnpd-nftables 全都还在)
#   根因: 不是这个文件没删干净, 而是官方 configs/release.config 第 8 行带着
#   CONFIG_PACKAGE_luci-app-upnp=y。kconfig 合并时 base 在前、本文件在后,
#   同名符号取最后一条 —— 只把本文件的上行删掉等于什么都没做, 必须显式写
#   "is not set" 覆盖回去。三个都要写: luci-app-upnp 会连带拉 i18n 和后端。
# ============================================================
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_luci-app-upnp-nftables is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# --- LuCI 组件 (对齐 18.1) ---
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_autocore=y

# --- IPTV: 2026-10-08 恢复 ---
#
# 包在 pbs05/openwrt-pon-userspace 的 luci-app-iptv/ —— feeds pin cce9d756 里就有
# (已按 ref 直取核对: Makefile + po/zh_Hans/iptv.po + root/etc/config/iptv 齐全)。
#
# 依赖只有三条, 基线全开, 不需要额外补:
#   +luci-base           基线默认
#   +firewall4           an7581.config:2767 =y
#   +kmod-nft-bridge     release.config:3 =y (an7581.config:3815 也是 y)
# 运行时: iptv-apply 用 nft 建 bridge 族过滤表 + netifd 建 8021q VLAN/br-iptv,
#   都要"LAN 口移出 br-lan"才生效 —— 依赖已够, 无需 igmpproxy/udpxy 之类。
#
# 中文: po/zh_Hans/iptv.po 存在 -> luci.mk 生成 luci-i18n-iptv-zh-cn。
#
# ⚠️ /etc/config/iptv 出厂是 enabled='0' —— 那是**应用默认不接管网络**的设计,
#   要用户在 LuCI「网络 → IPTV」里勾"启用"、选 LAN 口与服务 VLAN 才动作。
#   固件里带上 ≠ 刷完自动改网络。2026-10-06 曾以"enabled='0' 白编"为由砍掉,
#   2026-10-08 按需求恢复 —— 带上它才有这个页面可用。
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y

# --- adblock-fast: 2026-10-08 按需求移除 ---
#
# 三条一起关, 少一条都等于没关:
#   luci-app-adblock-fast        前端 (基线 an7581.config:6210 本就是 not set,
#                                这行是防回归的显式反向覆盖)
#   adblock-fast                 后端服务, 由前端 DEPENDS 拉进来 —— 关前端不写
#                                这行的话它仍可能被别处 select 回来
#   luci-i18n-adblock-fast-zh-cn 中文包。本 pin 里 po/zh_Hans/adblock-fast.po
#                                确实存在 (已按 ref 直取核对 200), 而上方
#                                CONFIG_LUCI_LANG_zh_Hans=y 会把**已启用应用**的
#                                i18n 默认成 y —— 所以必须显式关, 否则前端一开
#                                它就跟着进来。
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
# CONFIG_PACKAGE_adblock-fast is not set
# CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn is not set
#
# 顺手移除 2026-10-03 为它加的那批"推荐组件":
#   adblock-fast/Makefile 的 awk/grep/sed/sort 依赖是
#   `+!BUSYBOX_DEFAULT_AWK:gawk` 这种**条件**依赖 —— busybox 自带时根本不会拉。
#   这四行是本仓显式加的 (当年注释: "缺失会导致列表下载/解析异常")。
#   后端既然移除, 这四行不再服务任何东西 -> 一并关掉 (各几十 KB, 秒级收益)。
# 判据: 基线 an7581.config 里这四个全是 "is not set"
#   (gawk:8507 / grep:8519 / sed:8685 / coreutils-sort:8406),
#   且本仓再无第二处引用 —— 关得掉。
# CONFIG_PACKAGE_gawk is not set
# CONFIG_PACKAGE_grep is not set
# CONFIG_PACKAGE_sed is not set
# CONFIG_PACKAGE_coreutils-sort is not set
#
# coreutils-nohup **保留** —— 它不是 adblock-fast 的依赖, 是 2026-10-03 对齐
# 18.1 时单独加的那批 (同批还有 ruby / autocore / luci-mod-admin-full / luci-lib-uqr)。
CONFIG_PACKAGE_coreutils-nohup=y

# --- yq: 已移除 (2026-10-04) ---
# 移除理由:
#   1. yq 是 Go 包, 编它要先 bootstrap 整套 Go 工具链 (十几分钟 + 几百 MB);
#   2. run #18 三次 make 全挂在它身上 —— Go module 缓存被 actions/cache 还原得
#      残缺时, 构建期离线补不回来, 必然失败。整条线被一个可选工具卡住不值得;
#   3. OpenClash 用的是 ruby-yaml 解析 YAML, 不依赖 yq;
#   4. 当初加它只是为了对齐 18.1 (那里 shellsync 在用), 而 shellsync 本身
#      实测没启用 (无 UCI 配置、无进程)。shellsync 的 DEPENDS 里也没有 yq。
# 真需要的话: 把 CONFIG_PACKAGE_yq=y 加回来, 并确认 ponwrt-diy-part1.sh 里
#             清 dl/go-mod-cache 那段还在 (那是 #18 的直接修复)。
# CONFIG_PACKAGE_yq is not set

# --- ruby: OpenClash 依赖 (实测 /usr/share/openclash/*.sh 引用 ruby) ---
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# --- 单线多拨: 保留, 因为它们根本关不掉 (2026-10-06 实测纠正) ---
#
# 一度把这三行写成 "is not set" 想省编译, run #26 的注解证明无效:
# defconfig 之后 three 全被顶回 =y。
#
# 原因 (硬依赖 + select 优先级):
#   package/network/services/ppp/Makefile:56       Package/ppp       DEPENDS:= ... +shellsync +kmod-mppe
#   package/network/services/shellsync/Makefile:12 Package/shellsync DEPENDS:=+libpthread +kmod-macvlan
#   include/target.mk:52  DEFAULT_PACKAGES.router 含 ppp / ppp-mod-pppoe
#     -> scripts/target-metadata.pl:262 给设备 profile 生成 `select DEFAULT_ppp`
#     -> scripts/package-metadata.pl:355 给 `config PACKAGE_ppp` 生成 `default y if DEFAULT_ppp`
#     -> mconf_depends() 把 `+shellsync`/`+kmod-mppe`/`+kmod-macvlan` 升成 `select PACKAGE_xxx`
#   select 压过用户写的 "is not set" —— 写多少遍都没用。
#
# 要真关掉只能改 ppp 的 Makefile, 那会砍掉 PPPoE 的 MPPE 加密与多拨同步, 不做。
# 收益本来就以秒计 (shellsync 是单个 .c, 另两个各一个 .ko), 不值得动核心包。
# 18.1 现网也装了这三个 —— 保留反而更贴合对齐目标。
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_kmod-macvlan=y

# --- 内存扩展: zram 压缩内存盘 ---
# 2026-10-03: 恢复编译。18.1 那台是 1G 版 (952MB 可用内存) 用不上, 但
# 内存更小的同型号设备需要 zram 做 OOM 兜底 —— 内核版本一变, 外部 apk 源
# 里就没有配套的 kmod-zram, 只能编进固件, 所以默认带上。
# 代价: 约 200KB 固件体积 + 一点 RAM; 不需要的设备可注释掉下面 5 行。
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lzo-rle=y
CONFIG_PACKAGE_kmod-lib-lz4=y

# --- PON 全栈: 官方 an7581.config 里部分包是 =m (只构建不进镜像),
#     必须显式 =y 覆盖, 否则 PON 口/身份配置功能缺失 ---
# 核心内核模块
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
# PON 光前端 EN7572 驱动+固件 (airoha-xpon 的 "optical frontend provider",
#     缺失 => xpon probe 挂起, 无 pon0/omci0, PON 激活失败)
CONFIG_PACKAGE_kmod-airoha-en7572=y
# 2.5G 网口 lan1 的 EN8811H PHY 驱动 (缺失 => could not attach PHY: -22)
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
# EN8811H 的 MD32 固件 (官方配置里是 =m, 不进镜像; 可用固件里是安装的)
CONFIG_PACKAGE_airoha-en8811h-firmware=y
# NPU 固件
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# PON 用户态: ponctl(身份/模式配置) + pond(守护进程) + LuCI 页面
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
# USB 5V 电源 regulator (DTS regulator-output 节点所需)
CONFIG_PACKAGE_kmod-regulator-userspace-consumer=y

# --- 网络/工具 ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_unzip=y
# --- i2c: 2026-10-06 关掉 ---
#
# an7581.config 里是 CONFIG_PACKAGE_i2c-tools=y (8524) + CONFIG_PACKAGE_libi2c=m (5788),
# 两条都要覆盖, 少一条就等于没关:
#   i2c-tools  DEPENDS:=+libi2c            -> 把 libi2c 的 m 顶成 y
#   libi2c     =m **照样编译**, 只是不进镜像
# 所以只关 i2c-tools 的话 libi2c 会退回 =m 继续编, 省不下来。
#
# 关得掉的判据 (已逐个核实, 参照 ppp 那次 select 的教训):
#   谁 DEPENDS/select 它们 (feeds 全量 grep):
#     luci-app-oled  LUCI_DEPENDS:=+luci-compat +i2c-tools +libconfig   -> an7581.config:6288 is not set
#     python3-smbus  DEPENDS:=+libi2c +python3-light                    -> an7581.config:4820 is not set
#     meshtasticd    DEPENDS 含 +libi2c                                 -> 三个变体全 is not set
#   -> 三个上游 select 源都不活跃, 关掉能生效。
#
# 另一条路: 改 feeds/packages/utils/i2c-tools 的 Makefile 改不动(不在本仓),
# 而且本设备根本用不到 i2c (an7581.mk 的 XG-040G-MD 设备块 DEVICE_PACKAGES 里
# 没有任何 i2c 包, PON 用户态也零处引用 i2cget/i2cset/i2cdetect)。
#
# 收益预期: 小。i2c-tools = 几个 C 小工具, libi2c = ~20KB 的 .so, 另外省掉
#   i2c-tools 的构建依赖 python-setuptools/host。以秒计, 不是这次提速的主力 ——
#   主力是关 DEBUG_INFO + ccache。关它主要是为了配置干净。
# CONFIG_PACKAGE_i2c-tools is not set
# CONFIG_PACKAGE_libi2c is not set

# --- WiFi 全家桶: 2026-10-06 关掉 (本设备**没有 WiFi 硬件**) ---
#
# 判据 (硬件层, 不是猜的):
#   target/linux/airoha/dts/an7581-nokia_xg-040g-md-common.dtsi
#     -> 全文无 pcie / wlan / wifi / mt7915 节点, 也不 include
#        an7581-npu-wlan.dtsi 或 an7581-npu-mt7992.dtsi
#   an7581.mk:347 的 XG-040G-MD DEVICE_PACKAGES 里没有任何 WiFi 包
#   target/linux/airoha/Makefile / an7581/target.mk 的 DEFAULT_PACKAGES 里也没有
#   include/target.mk 的 DEFAULT_PACKAGES.router 里也没有 wpad/hostapd
# -> 下面这一整套 =m 全是 PonWrt 官方 seed (an7581.config 要兼顾 q1000k / evb /
#    zn504xg-d 等带 WiFi 的 an7581 板子) 带进来的冗余。=m 照样编译, 只是不进镜像。
#
# 收益: 这是本次砍包里唯一有分量的 ——
#   wpad-openssl + hostapd-common: 用户态, 编 hostapd 全套并链 openssl
#   kmod-mac80211 + kmod-cfg80211: 无线子系统核心
#   kmod-mt76-core / mt76-connac / mt7915e / mt7916-firmware: mt76 驱动 + 固件
#   (znxt-zn515-mt7916-eeprom 更离谱, 是另一块板子 zn504xg-d 的 MT7916 EEPROM)
# 对比之下 hwmon-core / i2c-core 只是两个小 .ko, 顺带而已。
#
# 风险: feeds 里的 luci-app-* 若 DEPENDS wpad 会被 select 拉回 —— 拉回就拉回,
# 本仓对这批符号**只观测不断言** (见 diy-part2.sh 的 SYMS 注解), 不会判死。
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916-firmware is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
# CONFIG_PACKAGE_znxt-zn515-mt7916-eeprom is not set

# --- 冗余 PHY: 2026-10-06 关掉 (本设备只有 en8811 + SoC 内置 GSW PHY) ---
#
# 判据 (DTS):
#   an7581-nokia_xg-040g-md-common.dtsi:168  en8811: ethernet-phy@f
#       compatible = "ethernet-phy-id03a2.a411"   <- Airoha EN8811H, 2.5G 口
#   an7581.dtsi:1104  gsw_phy2/3/4  phy-mode = "internal"  <- SoC 内置千兆 PHY
# -> 外接 PHY 只有 en8811 一个。phy-realtek / phy-maxlinear 是 seed 为其它板子
#    准备的 (DEVICE_PACKAGES 里只有 kmod-phy-airoha-en8811h)。
#    rtl826x-firmware 同理 (RTL826x 是 Realtek PHY 的固件)。
#
# ⚠️ 关这两个的意义不只是省时间: 它们正是把 kmod-hwmon-core select 住的两路
#    (netdevices.mk:566 phy-realtek / :297 phy-maxlinear)。关掉之后 hwmon-core
#    才关得掉, 再往下 kmod-i2c-core 才关得掉。见下一段。
# CONFIG_PACKAGE_kmod-phy-realtek is not set
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set
# CONFIG_PACKAGE_rtl826x-firmware is not set

# --- hwmon-core / i2c-core: 2026-10-06 关掉 (上游已被上面两段清空) ---
#
# 之前判定 i2c-core "关不掉", 是因为这条链:
#   mt7915e(=m) ─┐
#   phy-realtek(=m) ─┼─ select ─→ kmod-hwmon-core(=m) ─ select ─→ kmod-i2c-core(=m)
#   phy-maxlinear(=m) ─┘
#   (hwmon.mk:12  KernelPackage/hwmon-core  DEPENDS:=+kmod-i2c-core)
# 上面两段把三个上游全部关掉之后, 这条链就断了 —— 现在才关得掉。
# 注意顺序: 先关上游, 再关下游。反过来写没用 (select 压过 is not set)。
# CONFIG_PACKAGE_kmod-hwmon-core is not set
# CONFIG_PACKAGE_kmod-i2c-core is not set

# --- 内核模块 ---
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
# ovpn backport: 2026-10-06 砍掉 (实测无 VPN 配置, 且是一整棵内核 backport 树)
# CONFIG_PACKAGE_kmod-ovpn-backports is not set
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
# PPTP MPPE 加密: 保留 —— 由 ppp 强制 (Package/ppp DEPENDS:= ... +kmod-mppe,
# 见上方"单线多拨"段的完整链路)。写 "is not set" 会被 select 顶回来, run #26 已实测。
CONFIG_PACKAGE_kmod-mppe=y

# --- Flash/UBI 工具 ---
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_block-mount=y

# ============================================================
# 编译耗时 (2026-10-06): 关掉内核/内核模块的调试信息
#
#   官方 configs/an7581.config 里 CONFIG_KERNEL_DEBUG_INFO(+_REDUCED)=y
#   -> 内核 vmlinux 与全部 kmod(79 个) 都带 DWARF: 链接慢、体积大、14 GB 的
#      runner 盘压力大(盘见底不报错, 会变成 I/O 抖动, 表现就是"莫名变慢")。
#
#   只关 DEBUG_INFO, 保留 CONFIG_KERNEL_DEBUG_KERNEL / DEBUG_FS
#   -> /sys/kernel/debug 与 PON/NPU 的 debug 节点不受影响。
#   代价: 失去 kgdb / perf 的带符号回溯 —— 生产路由器不需要。
#
#   实测锚点(GitHub API 的 step 级耗时, 4 vCPU 标准 runner):
#     #16 230.2min / #20 214.2min / #21 209.9min / #24 198.3min
# ============================================================
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set

# ============================================================
# 编译加速 (2026-10-06): ccache
#
#   rules.mk:347 只在 CONFIG_CCACHE 非空时才把 ccache 塞进 TARGET_CC/HOSTCC;
#   CCACHE_DIR 默认 $(TOPDIR)/.ccache = /workdir/openwrt/.ccache, 由 workflow 的
#   "Cache ccache" 步骤跨构建缓存; CCACHE_COMPILERCHECK=content 在 workflow 里设。
#   打开后还会顺带编一个 tools/ccache 4.13.3(host 工具, 一次性)。
#
#   必须实测命中率: 跑完看编译步骤末尾打印的 `ccache -s`, cache hit 太低就撤掉这行
#   (命中依赖工具链二进制的稳定性)。GitHub 缓存总配额 10 GB/仓库, 要和 dl/ 一起算账。
# ============================================================
CONFIG_CCACHE=y

# ============================================================
# 2026-10-03 按 18.1 路由器 (/etc/apk/world) 全量对齐:
#   新增: luci-app-iptv(+i18n) / luci-mod-admin-full / luci-lib-uqr /
#         autocore / coreutils-nohup / yq / ruby + ruby-yaml /
#         shellsync + kmod-macvlan / kmod-mppe
#   移除: qrencode (18.1 无) / luci-app-upnp (18.1 无) /
#         kmod-usb-xhci-mtk (MTK 专用, AN7581 用不上)
# 实测 18.1: wg 接口在用、OpenClash 脚本引用 ruby、PPPoE 单拨在用;
#   shellsync/macvlan/ovpn/mppt 装了但没启用 (见上方注释)
#
# 2026-10-04 (run #16 复盘):
#   openclash: luci feed 从 f4f91aee(9/23) 改 pin 到 ed0441b1(10/02 merge) ——
#              前者那批第三方 LuCI 应用被拆走了, 包不存在, 写 =y 也会被
#              defconfig 静默删掉, 编译通过但固件里没有。
#   upnp:      官方 release.config 强制带 luci-app-upnp, 这里用 "is not set"
#              反向覆盖 (只删掉本文件里那一行是无效的)。
#   yq:        整体移除 —— Go 包, 跑 #18 就挂在它 (Go module 缓存残缺 +
#              构建期离线, 重试必现); OpenClash 用 ruby-yaml, 不需要它。
#              代价只是少个命令行工具, 收益是少编一套 Go 工具链。
#
# 2026-10-06 (编译耗时优化):
#   砍: luci-app-iptv(+i18n) / kmod-ovpn-backports。
#       iptv 只被本仓打开、无人 select; kmod-ovpn-backports 的上游 select 源
#       (openvpn) 未启用 -> 实测这两项都真的关掉了。
#       (iptv 已于 2026-10-08 按需求恢复, 见下)
#   保留: shellsync / kmod-macvlan / kmod-mppe —— **ppp 的硬依赖, 关不掉**
#       (完整链路见上方"单线多拨"段)。run #26 的注解实测纠正:
#       写 "is not set" 会被 mconf_depends 生成的 select 顶回 =y。
#   关: CONFIG_KERNEL_DEBUG_INFO (见上方注释)
#   开: CONFIG_CCACHE (见上方注释)
#   另核查过(未改动): CONFIG_MODULE_DEFAULT_* 整族在本树是死符号
#       (depends on TARGET_PER_DEVICE_ROOTFS, 该符号已不存在) ——
#       an7581.config 里写了 56 条, defconfig 后 build.config 里 0 条。
#       i2c-tools + libi2c 已于 2026-10-06 关掉 —— 两者必须一起关
#       (i2c-tools DEPENDS +libi2c; libi2c =m 照样编译)。
#   保留: CONFIG_PACKAGE_kmod-i2c-core=m (an7581.config:3508) —— **关不掉**,
#       2026-10-06 逐层核查定案, 与 ppp 那次同构的 select 陷阱:
#         package/kernel/linux/modules/hwmon.mk:12
#             KernelPackage/hwmon-core  DEPENDS:=+kmod-i2c-core
#         -> select PACKAGE_kmod-i2c-core (mconf_depends, 被 m 者限成 m)
#       而 kmod-hwmon-core 自己 =m 且被三路 select, 全是基线已启用的:
#         package/kernel/mt76/Makefile:238            mt7915e (WiFi, =m)
#         package/kernel/linux/modules/netdevices.mk:566  phy-realtek (=m)
#         package/kernel/linux/modules/netdevices.mk:297  phy-maxlinear (=m)
#       -> 要关 i2c-core 就得先关 hwmon-core, 就得连 WiFi 驱动一起关。不做。
#       收益本就 ≈ 0 (单个几十 KB 的 .ko, 秒级), 不值得赌一次 1.5~3h 构建。
#
# 2026-10-08 (基于上游 master HEAD 04986da1e 的编译结构, 按需求调整):
#   恢复: luci-app-iptv + luci-i18n-iptv-zh-cn (=y, 详见上方 IPTV 段)。
#       依赖 luci-base / firewall4 / kmod-nft-bridge 基线全开, 不需要补。
#       diy-part2.sh 的"指定包含"断言表已同步收录这两个符号;
#       required-packages.txt 也加了两行做产物层兜底。
#   移除: adblock-fast 全家 —— luci-app-adblock-fast / adblock-fast /
#       luci-i18n-adblock-fast-zh-cn, 外加当年为它加的四个"推荐组件"
#       gawk / grep / sed / coreutils-sort。三道闭环同步:
#         extra.config 反向覆盖 -> diy-part2.sh 配置层 FORBID_PKG_LIST
#         -> workflow FORBID_PKGS 产物层反向校验。
#       ⚠️ 这七个符号**只出现在这三处**, 不要塞进 REQUIRED_PKGS。
#   保留: coreutils-nohup (不属于 adblock 依赖, 是 18.1 对齐项)。
