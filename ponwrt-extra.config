# ============================================================
# PonWrt 自定义附加包（在 configs/an7581.config 基础上追加）
# 基础配置已含: PON 全套(luci-app-pon/ponctl/pond/xpon)、NPU 固件、
#               EN8811H 固件、LuCI 基础、firewall、ppp 等
# ============================================================

# --- LuCI 中文 ---
CONFIG_LUCI_LANG_zh_Hans=y

# --- 覆盖基础配置: 关掉 argon 主题（旧固件只用 bootstrap）---
# CONFIG_PACKAGE_luci-theme-argon is not set

# --- LuCI 应用（openclash 在 ImmortalWrt luci feed 内）---
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# --- 对齐现网路由器已安装的应用（均在 ImmortalWrt luci feed 内）---
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# --- shellsync (单线多拨) : ponwrt 树内自带 package/network/services/shellsync ---
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_kmod-macvlan=y

# --- 内存扩展: zram 压缩内存盘 (512MB 无 swap 设备 OOM 兜底) ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lzo-rle=y
CONFIG_PACKAGE_kmod-lib-lz4=y

# --- 网络/工具 ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_i2c-tools=y

# --- 内核模块 ---
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ovpn-backports=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# --- Flash/UBI 工具 ---
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_block-mount=y

# ============================================================
# 注意: luci-app-iptv (旧固件自带) 在 ponwrt 树内及所有公开 feeds 中
# 均不存在，属旧编译者私有树内包，公开渠道无法复刻，本固件不包含。
# 如需找回，请提供该包的源码仓库后在 diy-part1.sh 添加 feed。
# ============================================================
