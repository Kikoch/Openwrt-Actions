# ============================================================
# ONU 编译线自定义附加包
#   追加到 2010.config 之后 (由 onu-diy-part2.sh cat 进去)
#   同名符号取最后一条 -> 这里可以反向覆盖种子配置里的 =y
#
# 对齐目标: 昨日 GitHub Actions 产物 run #32 的服务与功能包
#   (pbs05/ponwrt @04986da1e, ponwrt-extra.config 的 74 个显式 =y)
#
# 适配结果 (逐条实测 2010.config @8243d9a5, 不是猜):
#   44 个  在新基线已经是 =y        -> 仍显式写一遍, 防止将来基线变动
#   23 个  基线是 not set           -> 这里显式打开
#    2 个  包名变更                 -> luci-app-pon -> luci-app-onu (+i18n)
#    2 个  包被吸收, 删除           -> luci-app-iptv (+i18n)
#    1 个  该 fork 无此包, 删除     -> kmod-lib-lzo-rle
#    1 个  新增 (luci-app-onu 硬依赖) -> omcproxy
# ============================================================

# ============================================================
# 一、LuCI 与界面 (对齐昨天)
# ============================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_autocore=y

# ============================================================
# 二、ONU / PON 全栈
#
# ⚠️ 与昨天的差异 —— 换源带来的**包名变更**, 不是无缝替换:
#   luci-app-pon        -> luci-app-onu        (升为顶级 ONU 菜单, 七个子页)
#   luci-i18n-pon-zh-cn -> luci-i18n-onu-zh-cn
#   luci-app-iptv(+i18n) -> **删除**: 已被吸收进 luci-app-onu, 独立包不存在。
#      留着不会报错, 只会被 defconfig 静默删符号 —— 正是 run #16 openclash
#      那个坑的同构版本。功能没丢, 入口从「网络 → IPTV」变成「ONU → IPTV」。
# ============================================================
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-i18n-onu-zh-cn=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
# PON 光前端 EN7572 驱动 (airoha-xpon 的 "optical frontend provider",
#     缺失 => xpon probe 挂起, 无 pon0/omci0, PON 激活失败)
CONFIG_PACKAGE_kmod-airoha-en7572=y
# 2.5G 网口 lan1 的 EN8811H PHY 驱动 + MD32 固件
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# USB 5V 电源 regulator (DTS regulator-output 节点所需)
CONFIG_PACKAGE_kmod-regulator-userspace-consumer=y

# omcproxy: **昨天没有、本线必需** —— luci-app-onu 的 LUCI_DEPENDS 硬依赖
#   (IGMPv3/MLDv2 组播代理, 支撑 IPTV 页的 snooping/proxy 开关)。
#   2010.config 里查无此符号, 不显式打开的话 defconfig 会因依赖不满足把
#   luci-app-onu 顶成 =m 或直接丢掉 —— 表现为"编译绿、ONU 菜单没有"。
CONFIG_PACKAGE_omcproxy=y

# ============================================================
# 三、代理 / 网络服务 (对齐昨天)
# ============================================================
CONFIG_PACKAGE_luci-app-openclash=y
# OpenClash 的两个后端依赖: ruby + ruby-yaml (读 YAML 配置)
#   两个包都在 feeds/packages/lang/ruby/, 基线是 not set, 必须显式打开。
#   ruby-yaml 在 2010.config 里查无符号但包确实存在 (Makefile:1156)。
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
# nftables tproxy + inet-diag: 透明代理与连接诊断
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ca-bundle=y

# DDNS
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# WireGuard
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# ppp 相关 (shellsync/macvlan/mppe 是 ppp 的硬依赖, 关不掉, 保持 =y)
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-mppe=y

# BBR / tun
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ============================================================
# 四、zram: 小内存设备 OOM 兜底
#   ⚠️ 与昨天的差异: 删掉 kmod-lib-lzo-rle —— 该 fork 没有这个包
#      (新版内核的 zram 后端改成 KERNEL_ZRAM_BACKEND_* / DEF_COMP_* 配置,
#       other.mk:718 的条件依赖里已无 lib-lzo-rle 这一项)。
#   kmod-lib-lzo / kmod-lib-lz4 保留 (lib-lzo 在 lib.mk:106 有定义)。
# ============================================================
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lz4=y

# ============================================================
# 五、USB 与文件系统 (对齐昨天)
#   基线全是 not set, 这里显式打开。
#   ⚠️ XG-040G-MD 实际没有外置 USB 口, 但昨天产物带了这些, 按"保持一致"保留。
# ============================================================
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y

# ============================================================
# 六、工具集 (对齐昨天)
# ============================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_uboot-envtools=y

# ============================================================
# 七、开关项
# ============================================================

# --- 主题: 只保留 bootstrap ---
# 基线 2010.config 里 luci-theme-argon 是 =y, 必须显式反向覆盖
# (同名符号取最后一条; 只删上游那行无效)。
#
# ⚠️⚠️ 光写 "# CONFIG_PACKAGE_luci-theme-argon is not set" **压不住**:
#   2010.config:5173 有 CONFIG_PACKAGE_luci-app-argon-config=y, 而
#   luci-app-argon-config 的 Makefile 是 LUCI_DEPENDS:=+luci-theme-argon,
#   在生成的 tmp/.config-package.in 里就是 `select PACKAGE_luci-theme-argon`。
#   **kconfig 的 select 优先级高于 "# ... is not set"** —— 只要 argon-config
#   开着, argon 主题必然被拉回 =y (run #1 就是死在这里: 配置层断言
#   "FATAL: 已砍掉的包又冒出来了: luci-theme-argon")。
#   想只留 bootstrap, 必须连 argon-config 一起关。
#   (同类坑见 ponwrt 线 run #26: ppp -> shellsync -> kmod-macvlan/kmod-mppe)
# 三道保险: 这里 "is not set" -> onu-diy-part2.sh 配置层硬断言 ->
#   workflow FORBID_PKGS 产物层反向校验。
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-footstrap is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

# --- UPnP: 关 ---
# configs/release.config 与 2010.config 都是 =y, 必须反向覆盖。
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# --- adblock-fast 全家: 关 (基线本就没开, 防回归) ---
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
# CONFIG_PACKAGE_adblock-fast is not set
# CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn is not set

# --- 内核与全部 kmod 不产 DWARF 调试信息 ---
# 基线 2010.config 里 CONFIG_KERNEL_DEBUG_INFO 是 **=y**, 必须反向覆盖。
# ⚠️ 必须写成 "# ... is not set" 而不是删行: include/kernel-defaults.mk 用 awk
#    把 .config 里的 CONFIG_KERNEL_* 剥前缀后追加到内核 .config.target,
#    直接删行等于没关。
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set

# --- ccache ---
# 基线 CONFIG_DEVEL 是 not set、CONFIG_CCACHE 根本不存在。
# CCACHE 依赖 DEVEL, 两个都要开。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
