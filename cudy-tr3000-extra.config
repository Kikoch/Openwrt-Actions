# ============================================================
# ImmortalWrt openwrt-25.12 稳定分支 + Cudy TR3000 附加包
# ============================================================

# --- LuCI 中文 ---
CONFIG_LUCI_LANG_zh_Hans=y

# --- OpenClash 代理 ---
CONFIG_PACKAGE_luci-app-openclash=y

# --- 内存扩展: zram 压缩内存盘 ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lzo-rle=y
CONFIG_PACKAGE_kmod-lib-lz4=y

# --- adblock-fast 及其推荐组件 ---
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_coreutils-sort=y

# --- WireGuard 服务 ---
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# --- DDNS 服务 ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y

# ============================================================
# QModem 模组管理套件 (来自 .github/workflows/QModem.yml)
# 与原 workflow 差异: 全部 =y 编入固件 (原为 =m 单独出 apk 包);
# luci-i18n-qmodem-ru (俄语) 未纳入
# ============================================================
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_generic-qmi-wwan=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn=y
CONFIG_PACKAGE_luci-i18n-qmodem-sms-zh-cn=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_tom_modem_EARLY_RETURN=y
CONFIG_PACKAGE_tom_modem_ENABLE_UBUS_DAEMON=y
CONFIG_PACKAGE_quectel-CM-5G-M=y
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_ubus-at-daemon=y
# QModem.yml 编译循环里出现过, feed 中存在则编入:
CONFIG_PACKAGE_sms_forwarder=y
